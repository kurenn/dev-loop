diff --git a/app/controllers/api/v1/base_controller.rb b/app/controllers/api/v1/base_controller.rb
new file mode 100644
index 0000000..ce4436e
--- /dev/null
+++ b/app/controllers/api/v1/base_controller.rb
@@ -0,0 +1,13 @@
+module Api
+  module V1
+    class BaseController < ActionController::API
+      # Intentionally parallel to ApplicationController, not a subclass of
+      # it (see PLAN.md Design decision 1). Any cross-cutting filter added
+      # to ApplicationController later (auth, tenancy, request context)
+      # will NOT apply here and must be added to this class too.
+      rescue_from ActiveRecord::RecordNotFound do
+        render json: { error: "not_found" }, status: :not_found
+      end
+    end
+  end
+end
diff --git a/app/controllers/api/v1/projects_controller.rb b/app/controllers/api/v1/projects_controller.rb
new file mode 100644
index 0000000..1930966
--- /dev/null
+++ b/app/controllers/api/v1/projects_controller.rb
@@ -0,0 +1,82 @@
+module Api
+  module V1
+    class ProjectsController < BaseController
+      # Pagination is best-effort traversal, not a snapshot: each page is an
+      # independent LIMIT/OFFSET query against a live table, not a query
+      # against a fixed point in time. A project concurrently inserted,
+      # renamed, archived, or deleted before the current offset can shift
+      # every row after it, so a record can appear on two pages or be
+      # skipped entirely between requests. Clients should de-duplicate by
+      # `id` and treat the list as eventually consistent, not a consistent
+      # cursor over a frozen set. Cursor/keyset pagination was considered
+      # and scoped out (see PLAN.md "Out") to keep this endpoint hand-rolled
+      # and simple; note that keyset on (name, id) would not even fix the
+      # rename case above — only a full snapshot strategy would, which is a
+      # re-architecture, not a pagination-style change.
+      def index
+        scope = Project.active
+        total = scope.count
+        records = scope.select(*LIST_ATTRIBUTES)
+                        .order(:name, :id)
+                        .limit(per_page)
+                        .offset((page - 1) * per_page)
+
+        render json: {
+          projects: records.as_json(only: LIST_ATTRIBUTES),
+          pagination: {
+            page: page,
+            per_page: per_page,
+            total_count: total,
+            total_pages: (total.to_f / per_page).ceil
+          }
+        }
+      end
+
+      def show
+        project = Project.find(params[:id])
+        render json: project.as_json(only: [ :id, :name, :description, :archived ])
+      end
+
+      private
+
+      # Single source of truth for the list endpoint's attribute allowlist,
+      # shared by the `select` (limits what is read off disk) and the
+      # `as_json(only:)` (limits what is serialized). Keeping these as one
+      # constant instead of two hand-synced literals prevents the silent
+      # no-op where adding an attribute to one list without the other
+      # appears to work (a partially loaded record's `as_json(only:)`
+      # quietly drops any attribute not also present in `select`). Not used
+      # by `show`, which loads and serializes the full record including
+      # `description`.
+      LIST_ATTRIBUTES = %i[id name archived].freeze
+
+      # Upper bound on `page`. Keeps the max possible OFFSET (MAX_PAGE * max
+      # per_page) four orders of magnitude inside SQLite's int64 bind limit,
+      # so a caller-controlled `page` can never overflow `(page - 1) * per_page`
+      # into a StatementInvalid/500. Deliberately a fixed constant, not
+      # data-dependent (e.g. not `total_pages + 1`), so the echoed
+      # `pagination.page` stays a stable, predictable contract.
+      MAX_PAGE = 1_000_000
+
+      # Clamped per Design decision 2. `.to_s` guards against non-String
+      # param shapes (e.g. a Hash/Array from `?page[]=1`) that would make
+      # `Integer(..., exception: false)` raise TypeError instead of
+      # returning nil. Base 10 is explicit so decimal-looking input isn't
+      # reinterpreted as hex/octal/binary (e.g. `010` must mean ten, not
+      # eight; `0x10` must fall back to the default rather than mean 16).
+      def page
+        @page ||= begin
+          n = Integer(params[:page].to_s, 10, exception: false)
+          n.nil? || n < 1 ? 1 : [ n, MAX_PAGE ].min
+        end
+      end
+
+      def per_page
+        @per_page ||= begin
+          n = Integer(params[:per_page].to_s, 10, exception: false)
+          n.nil? ? 25 : n.clamp(1, 100)
+        end
+      end
+    end
+  end
+end
