+++ b/app/controllers/api/v1/projects_controller.rb
@@ -0,0 +1,33 @@
+class Api::V1::ProjectsController < ActionController::API
+  RECORD_FIELDS = [ :id, :name, :description, :archived ].freeze
+
+  rescue_from ActiveRecord::RecordNotFound do
+    render json: { error: "not_found" }, status: :not_found
+  end
+
+  def index
+    page = params[:page].to_s.to_i.clamp(1, 1_000_000_000)
+    per_page = params[:per_page].to_s.to_i
+    per_page = 25 if per_page < 1
+    per_page = 100 if per_page > 100
+
+    projects = Project.active.order(:name, :id)
+    total = projects.count
+    records = projects.limit(per_page).offset((page - 1) * per_page)
+
+    render json: {
+      projects: records.as_json(only: RECORD_FIELDS),
+      pagination: {
+        page: page,
+        per_page: per_page,
+        total: total,
+        total_pages: (total / per_page.to_f).ceil
+      }
+    }
+  end
+
+  def show
+    project = Project.find(params[:id])
+    render json: project.as_json(only: RECORD_FIELDS)
+  end
+end
