diff --git a/app/controllers/api/v1/base_controller.rb b/app/controllers/api/v1/base_controller.rb
new file mode 100644
index 0000000..153afd0
--- /dev/null
+++ b/app/controllers/api/v1/base_controller.rb
@@ -0,0 +1,66 @@
+module Api
+  module V1
+    # Base controller for the versioned JSON API. Deliberately inherits from
+    # ActionController::API, not ApplicationController: ActionController::API
+    # omits view rendering, cookies/session/flash, and the browser/importmap
+    # -oriented ETag behaviour (`stale_when_importmap_changes`) that
+    # ApplicationController layers on for HTML responses. It also sidesteps
+    # `allow_browser versions: :modern`, which would 406 a recognized-but
+    # -outdated browser client (e.g. an old Chrome/Safari) hitting this API
+    # -- not something a JSON API should be filtering on.
+    class BaseController < ActionController::API
+      DEFAULT_PER_PAGE = 25
+      MAX_PER_PAGE = 100
+
+      rescue_from ActiveRecord::RecordNotFound, with: :render_not_found
+
+      private
+
+      # Paginates an ActiveRecord relation. Returns the (possibly empty)
+      # slice of records plus a pagination metadata hash. All clamping /
+      # coercion arithmetic lives here, in one place.
+      #
+      # When the requested page is beyond the last page, the offset query
+      # is skipped entirely (via `.none`) rather than clamping the page
+      # down — this both echoes the truthful requested page back to the
+      # client and structurally prevents an absurd `page` value from
+      # reaching SQL as an out-of-range OFFSET.
+      def paginate(scope)
+        page = coerce_positive_integer(params[:page], default: 1)
+        per_page = coerce_positive_integer(params[:per_page], default: DEFAULT_PER_PAGE)
+        per_page = MAX_PER_PAGE if per_page > MAX_PER_PAGE
+
+        total_count = scope.count
+        total_pages = total_count.zero? ? 0 : (total_count.to_f / per_page).ceil
+
+        records = page > total_pages ? scope.none : scope.offset((page - 1) * per_page).limit(per_page)
+
+        pagination = {
+          page: page,
+          per_page: per_page,
+          total_pages: total_pages,
+          total_count: total_count
+        }
+
+        [ records, pagination ]
+      end
+
+      # Coerces an untrusted param into a positive integer, never raising.
+      # `params[:per_page]` can arrive as an Array or Hash (e.g.
+      # `?per_page[]=5`), so we go through a string form and validate with
+      # a strict integer match before converting, rather than calling
+      # `.to_i` directly on the raw value.
+      def coerce_positive_integer(value, default:)
+        string = value.to_s
+        return default unless string.match?(/\A\d+\z/)
+
+        integer = string.to_i
+        integer.positive? ? integer : default
+      end
+
+      def render_not_found
+        render json: { error: { code: "not_found", message: "Resource not found" } }, status: :not_found
+      end
+    end
+  end
+end
diff --git a/app/controllers/api/v1/projects_controller.rb b/app/controllers/api/v1/projects_controller.rb
new file mode 100644
index 0000000..a7e2b90
--- /dev/null
+++ b/app/controllers/api/v1/projects_controller.rb
@@ -0,0 +1,20 @@
+module Api
+  module V1
+    class ProjectsController < BaseController
+      def index
+        records, pagination = paginate(Project.active.order(:name, :id))
+
+        render json: {
+          data: records.map { |project| ProjectSerializer.new(project).list },
+          pagination: pagination
+        }
+      end
+
+      def show
+        project = Project.find(params[:id])
+
+        render json: { data: ProjectSerializer.new(project).detail }
+      end
+    end
+  end
+end
diff --git a/app/serializers/api/v1/project_serializer.rb b/app/serializers/api/v1/project_serializer.rb
new file mode 100644
index 0000000..4760217
--- /dev/null
+++ b/app/serializers/api/v1/project_serializer.rb
@@ -0,0 +1,28 @@
+module Api
+  module V1
+    # Holds both response projections for Project so the field contract
+    # lives in one place.
+    class ProjectSerializer
+      LIST_ATTRIBUTES = %i[id name archived].freeze
+      DETAIL_ATTRIBUTES = %i[id name description archived created_at updated_at].freeze
+
+      def initialize(project)
+        @project = project
+      end
+
+      # Lean projection for the index action. Deliberately excludes
+      # `description` — the client is on a slow connection and does not
+      # need it in a list.
+      def list
+        @project.as_json(only: LIST_ATTRIBUTES)
+      end
+
+      # Full projection for the show action, including timestamps (ISO8601
+      # via ActiveSupport's default JSON time format) for local caching /
+      # sync on the client.
+      def detail
+        @project.as_json(only: DETAIL_ATTRIBUTES)
+      end
+    end
+  end
+end
