diff --git a/test/controllers/api/v1/projects_controller_test.rb b/test/controllers/api/v1/projects_controller_test.rb
new file mode 100644
index 0000000..ef3f56c
--- /dev/null
+++ b/test/controllers/api/v1/projects_controller_test.rb
@@ -0,0 +1,296 @@
+require "test_helper"
+
+class Api::V1::ProjectsControllerTest < ActionDispatch::IntegrationTest
+  # ---------------------------------------------------------------
+  # Helpers
+  # ---------------------------------------------------------------
+
+  # tasks.project_id carries an FK to projects, so tasks must be
+  # cleared first or SQLite raises SQLite3::ConstraintException.
+  def reset_projects!
+    Task.delete_all
+    Project.delete_all
+  end
+
+  def create_projects(count, prefix: "Project", archived: false)
+    count.times.map do |i|
+      Project.create!(name: "#{prefix} #{i.to_s.rjust(4, '0')}", archived: archived)
+    end
+  end
+
+  # ---------------------------------------------------------------
+  # List — shape and envelope
+  # ---------------------------------------------------------------
+
+  test "1: index returns 200 with data and pagination keys, data is an Array" do
+    get api_v1_projects_url
+    assert_response :success
+    body = JSON.parse(response.body)
+    assert body.key?("data")
+    assert body.key?("pagination")
+    assert_kind_of Array, body["data"]
+  end
+
+  test "2: index data entries expose exactly id, name, archived - no description leakage" do
+    get api_v1_projects_url
+    assert_response :success
+    body = JSON.parse(response.body)
+    entry = body["data"].first
+    assert_not_nil entry
+    assert_equal %w[archived id name].sort, entry.keys.sort
+    assert_not entry.key?("description")
+  end
+
+  test "3: archived projects are excluded from index data" do
+    get api_v1_projects_url
+    assert_response :success
+    body = JSON.parse(response.body)
+    names = body["data"].map { |p| p["name"] }
+    assert_includes names, "Alpha"
+    assert_not_includes names, "Zulu"
+  end
+
+  # ---------------------------------------------------------------
+  # List — pagination behaviour
+  # ---------------------------------------------------------------
+
+  test "4: defaults with no params - page 1, per_page 25" do
+    get api_v1_projects_url
+    assert_response :success
+    pagination = JSON.parse(response.body)["pagination"]
+    assert_equal 1, pagination["page"]
+    assert_equal 25, pagination["per_page"]
+  end
+
+  test "5: per_page=10 honoured, data length is 10" do
+    reset_projects!
+    create_projects(30)
+
+    get api_v1_projects_url, params: { per_page: 10 }
+    assert_response :success
+    body = JSON.parse(response.body)
+    assert_equal 10, body["data"].length
+    assert_equal 10, body["pagination"]["per_page"]
+  end
+
+  test "6: per_page=5000 clamped to 100, data length at most 100" do
+    reset_projects!
+    create_projects(150)
+
+    get api_v1_projects_url, params: { per_page: 5000 }
+    assert_response :success
+    body = JSON.parse(response.body)
+    assert_equal 100, body["pagination"]["per_page"]
+    assert_operator body["data"].length, :<=, 100
+  end
+
+  test "7: per_page boundary - 101 clamps to 100, 100 is allowed as-is" do
+    reset_projects!
+    create_projects(150)
+
+    get api_v1_projects_url, params: { per_page: 101 }
+    assert_response :success
+    assert_equal 100, JSON.parse(response.body)["pagination"]["per_page"]
+
+    get api_v1_projects_url, params: { per_page: 100 }
+    assert_response :success
+    assert_equal 100, JSON.parse(response.body)["pagination"]["per_page"]
+  end
+
+  test "8: per_page falls back to 25 for 0, negative, non-integer, and blank" do
+    reset_projects!
+    create_projects(30)
+
+    [ 0, -5, "abc", "" ].each do |value|
+      get api_v1_projects_url, params: { per_page: value }
+      assert_response :success
+      pagination = JSON.parse(response.body)["pagination"]
+      assert_equal 25, pagination["per_page"], "expected per_page=#{value.inspect} to fall back to 25"
+    end
+  end
+
+  test "9: per_page as an Array param returns 200, not 500" do
+    get "/api/v1/projects?per_page[]=5"
+    assert_response :success
+    body = JSON.parse(response.body)
+    assert_equal 25, body["pagination"]["per_page"]
+  end
+
+  test "10: page=2 returns the next slice - page 1 and page 2 ids are disjoint" do
+    reset_projects!
+    create_projects(30)
+
+    get api_v1_projects_url, params: { page: 1, per_page: 10 }
+    assert_response :success
+    page1_ids = JSON.parse(response.body)["data"].map { |p| p["id"] }
+
+    get api_v1_projects_url, params: { page: 2, per_page: 10 }
+    assert_response :success
+    page2_ids = JSON.parse(response.body)["data"].map { |p| p["id"] }
+
+    assert_equal 10, page1_ids.length
+    assert_equal 10, page2_ids.length
+    assert_empty(page1_ids & page2_ids)
+  end
+
+  test "11: total_count and total_pages are arithmetically correct for a non-exact final page" do
+    reset_projects!
+    create_projects(23)
+
+    get api_v1_projects_url, params: { per_page: 10 }
+    assert_response :success
+    pagination = JSON.parse(response.body)["pagination"]
+    assert_equal 23, pagination["total_count"]
+    assert_equal 3, pagination["total_pages"]
+
+    get api_v1_projects_url, params: { page: 3, per_page: 10 }
+    assert_response :success
+    body = JSON.parse(response.body)
+    assert_equal 3, body["data"].length
+    assert_equal 23, body["pagination"]["total_count"]
+    assert_equal 3, body["pagination"]["total_pages"]
+  end
+
+  test "12: ordering is stable across a page boundary when several projects share a name" do
+    reset_projects!
+
+    # Boundary sits between page 1 (per_page 5) and page 2. Several
+    # projects share the exact same name to prove the id tiebreaker.
+    duplicate_ids = 6.times.map do
+      Project.create!(name: "Duplicate", archived: false).id
+    end
+    other_ids = 4.times.map do |i|
+      Project.create!(name: "Solo #{i}", archived: false).id
+    end
+
+    per_page = 5
+    total = duplicate_ids.length + other_ids.length
+    total_pages = (total.to_f / per_page).ceil
+
+    collected_ids = []
+    (1..total_pages).each do |page|
+      get api_v1_projects_url, params: { page: page, per_page: per_page }
+      assert_response :success
+      body = JSON.parse(response.body)
+      collected_ids.concat(body["data"].map { |p| p["id"] })
+    end
+
+    # Independently compute the documented contract -- order by (name, id)
+    # -- in plain Ruby, rather than re-deriving it from the same query the
+    # controller runs. This is an ORDERED comparison, not a set comparison:
+    # it pins the exact sequence, so a regression that drops the `:id`
+    # tiebreaker or reorders by something else (e.g. created_at) is caught.
+    #
+    # Honesty check: on SQLite, the (archived, name, id) covering index
+    # already enumerates rows in (name, id) order, so `order(:name)` alone
+    # might coincidentally satisfy this today even without `:id` in the
+    # ORDER BY. This test still pins the documented contract and will catch
+    # a genuine ordering regression (different sort column, index change,
+    # or a database where the coincidence doesn't hold).
+    expected_order = Project.active.to_a.sort_by { |p| [ p.name.to_s, p.id ] }.map(&:id)
+    assert_equal expected_order, collected_ids
+    assert_equal collected_ids.uniq.length, collected_ids.length, "expected no duplicate ids across pages"
+  end
+
+  test "13: page beyond last returns 200 with empty data and truthful pagination" do
+    reset_projects!
+    create_projects(5)
+
+    get api_v1_projects_url, params: { page: 999, per_page: 10 }
+    assert_response :success
+    body = JSON.parse(response.body)
+    assert_equal [], body["data"]
+    assert_equal 999, body["pagination"]["page"]
+    assert_equal 5, body["pagination"]["total_count"]
+    assert_equal 1, body["pagination"]["total_pages"]
+  end
+
+  test "14: empty result set - data empty, total_count 0, total_pages 0" do
+    reset_projects!
+
+    get api_v1_projects_url
+    assert_response :success
+    body = JSON.parse(response.body)
+    assert_equal [], body["data"]
+    assert_equal 0, body["pagination"]["total_count"]
+    assert_equal 0, body["pagination"]["total_pages"]
+  end
+
+  # ---------------------------------------------------------------
+  # Show
+  # ---------------------------------------------------------------
+
+  test "15: show returns id, name, description, archived, created_at, updated_at" do
+    get api_v1_project_url(projects(:alpha))
+    assert_response :success
+    data = JSON.parse(response.body)["data"]
+    assert_equal %w[archived created_at description id name updated_at].sort, data.keys.sort
+    assert_equal "Alpha", data["name"]
+    assert_equal "First project", data["description"]
+    assert_equal false, data["archived"]
+  end
+
+  test "16: an archived project is retrievable by id via show" do
+    get api_v1_project_url(projects(:zulu))
+    assert_response :success
+    data = JSON.parse(response.body)["data"]
+    assert_equal "Zulu", data["name"]
+    assert_equal true, data["archived"]
+  end
+
+  test "17: unknown id returns 404 with a JSON error body" do
+    get api_v1_project_url(id: 999999999)
+    assert_response :not_found
+    assert_equal "application/json", response.media_type
+    body = JSON.parse(response.body)
+    assert body["error"].present?
+  end
+
+  # ---------------------------------------------------------------
+  # Namespace-level regression guards
+  # ---------------------------------------------------------------
+
+  test "18: non-browser User-Agent gets 200, not 406" do
+    get api_v1_projects_url, headers: { "User-Agent" => "MobileApp/1.0 (okhttp)" }
+    assert_response :success
+
+    # okhttp/absent UAs are never blocked by allow_browser (they aren't a
+    # "version-guarded" browser at all -- see ActionController::AllowBrowser),
+    # so the assertions above pass regardless of whether this controller
+    # inherits from ActionController::API or ApplicationController. They
+    # cannot, by themselves, prove this namespace is exempt from the guard.
+    #
+    # Chrome 40 IS version-guarded (allow_browser checks chrome/safari/
+    # firefox/opera/ie) and sits below the `versions: :modern` minimum
+    # (chrome: 120), so ApplicationController#allow_browser genuinely
+    # returns 406 for it. ActionController::API has no such filter, so this
+    # is the one User-Agent that actually discriminates "does this
+    # controller inherit ApplicationController's allow_browser" from
+    # "doesn't" -- without it, this test cannot fail.
+    get api_v1_projects_url, headers: {
+      "User-Agent" => "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/40.0.2214.115 Safari/537.36"
+    }
+    assert_response :success
+  end
+
+  test "18b: request with no User-Agent at all gets 200, not 406" do
+    get api_v1_projects_url, headers: { "User-Agent" => nil }
+    assert_response :success
+  end
+
+  test "19: legacy GET /projects still returns a bare array with no envelope" do
+    get projects_url
+    assert_response :success
+    body = JSON.parse(response.body)
+    assert_kind_of Array, body
+    assert_not body.is_a?(Hash)
+  end
+
+  test "20: legacy GET /projects/:id returns the original object shape" do
+    get project_url(projects(:alpha))
+    assert_response :success
+    body = JSON.parse(response.body)
+    assert_equal %w[archived description id name].sort, body.keys.sort
+    assert_equal "Alpha", body["name"]
+  end
+end
