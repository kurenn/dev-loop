diff --git a/test/controllers/api/v1/projects_controller_test.rb b/test/controllers/api/v1/projects_controller_test.rb
new file mode 100644
index 0000000..dee1f4b
--- /dev/null
+++ b/test/controllers/api/v1/projects_controller_test.rb
@@ -0,0 +1,252 @@
+require "test_helper"
+
+module Api
+  module V1
+    class ProjectsControllerTest < ActionDispatch::IntegrationTest
+      # --- index ---------------------------------------------------------
+
+      test "index returns 200 with data and pagination keys present" do
+        get api_v1_projects_url
+        assert_response :success
+        assert_equal "application/json", response.media_type
+
+        json = JSON.parse(response.body)
+        assert json.key?("data"), "expected response body to have a \"data\" key"
+        assert json.key?("pagination"), "expected response body to have a \"pagination\" key"
+      end
+
+      test "index excludes archived projects" do
+        Project.create!(name: "IndexVisibleTest", archived: false)
+        Project.create!(name: "IndexHiddenTest", archived: true)
+
+        get api_v1_projects_url(per_page: 100)
+        assert_response :success
+
+        names = JSON.parse(response.body)["data"].map { |p| p["name"] }
+        assert_includes names, "IndexVisibleTest"
+        assert_not_includes names, "IndexHiddenTest"
+        assert_not_includes names, "Zulu"
+      end
+
+      test "index defaults to page 1 and per_page 25" do
+        get api_v1_projects_url
+        assert_response :success
+
+        pagination = JSON.parse(response.body)["pagination"]
+        assert_equal 1, pagination["page"]
+        assert_equal 25, pagination["per_page"]
+      end
+
+      test "index honours a valid per_page below the cap" do
+        5.times { |i| Project.create!(name: "PerPageTest #{i}", archived: false) }
+
+        get api_v1_projects_url(per_page: 5)
+        assert_response :success
+
+        json = JSON.parse(response.body)
+        assert_equal 5, json["data"].length
+        assert_equal 5, json["pagination"]["per_page"]
+      end
+
+      test "index clamps per_page above the cap to 100" do
+        101.times { |i| Project.create!(name: "CapTest #{i}", archived: false) }
+
+        get api_v1_projects_url(per_page: 1000)
+        assert_response :success
+
+        json = JSON.parse(response.body)
+        assert_equal 100, json["data"].length
+        assert_equal 100, json["pagination"]["per_page"]
+      end
+
+      test "index coerces junk per_page to the default of 25" do
+        ["abc", "0", "-5"].each do |bad_per_page|
+          get api_v1_projects_url(per_page: bad_per_page)
+          assert_response :success
+
+          pagination = JSON.parse(response.body)["pagination"]
+          assert_equal 25, pagination["per_page"],
+            "per_page=#{bad_per_page.inspect} should coerce to the default of 25"
+        end
+      end
+
+      test "index coerces junk or negative page to page 1" do
+        ["abc", "0", "-3"].each do |bad_page|
+          get api_v1_projects_url(page: bad_page)
+          assert_response :success
+
+          pagination = JSON.parse(response.body)["pagination"]
+          assert_equal 1, pagination["page"],
+            "page=#{bad_page.inspect} should coerce to page 1"
+        end
+      end
+
+      test "index tolerates non-scalar per_page shapes without raising" do
+        get api_v1_projects_url, params: { per_page: [ 1 ] }
+        assert_response :success
+        assert_equal 25, JSON.parse(response.body)["pagination"]["per_page"],
+          "an Array-shaped per_page (per_page[]=1) should degrade to the default, not 500"
+
+        get api_v1_projects_url, params: { per_page: { x: 1 } }
+        assert_response :success
+        assert_equal 25, JSON.parse(response.body)["pagination"]["per_page"],
+          "a Hash-shaped per_page (per_page[x]=1) should degrade to the default, not 500"
+      end
+
+      test "index tolerates non-scalar page shapes without raising" do
+        get api_v1_projects_url, params: { page: [ 1 ] }
+        assert_response :success
+        assert_equal 1, JSON.parse(response.body)["pagination"]["page"],
+          "an Array-shaped page (page[]=1) should degrade to page 1, not 500"
+
+        get api_v1_projects_url, params: { page: { x: 1 } }
+        assert_response :success
+        assert_equal 1, JSON.parse(response.body)["pagination"]["page"],
+          "a Hash-shaped page (page[x]=1) should degrade to page 1, not 500"
+      end
+
+      test "index tolerates a bignum page without raising" do
+        get api_v1_projects_url, params: { page: "9" * 30 }
+        assert_response :success
+
+        json = JSON.parse(response.body)
+        assert_equal [], json["data"]
+      end
+
+      test "index reports accurate total_count and total_pages" do
+        7.times { |i| Project.create!(name: "TotalCountTest #{i}", archived: false) }
+        expected_total = Project.active.count
+
+        get api_v1_projects_url(per_page: 3)
+        assert_response :success
+
+        pagination = JSON.parse(response.body)["pagination"]
+        assert_equal expected_total, pagination["total_count"]
+        assert_equal (expected_total / 3.0).ceil, pagination["total_pages"]
+      end
+
+      test "index page past the end returns 200 with empty data and accurate pagination" do
+        2.times { |i| Project.create!(name: "PastEndTest #{i}", archived: false) }
+        expected_total = Project.active.count
+
+        get api_v1_projects_url(per_page: 2, page: 5)
+        assert_response :success
+
+        json = JSON.parse(response.body)
+        assert_equal [], json["data"]
+        assert_equal 5, json["pagination"]["page"]
+        assert_equal 2, json["pagination"]["per_page"]
+        assert_equal expected_total, json["pagination"]["total_count"]
+        assert_equal (expected_total / 2.0).ceil, json["pagination"]["total_pages"]
+      end
+
+      test "index paginates with stable ordering so every record appears exactly once" do
+        created_ids = 6.times.map { Project.create!(name: "Duplicate", archived: false).id }
+
+        get api_v1_projects_url(per_page: 2)
+        assert_response :success
+        first_page = JSON.parse(response.body)
+        total_pages = first_page["pagination"]["total_pages"]
+        total_count = first_page["pagination"]["total_count"]
+
+        all_ids = first_page["data"].map { |p| p["id"] }
+        (2..total_pages).each do |page|
+          get api_v1_projects_url(per_page: 2, page: page)
+          assert_response :success
+          all_ids.concat(JSON.parse(response.body)["data"].map { |p| p["id"] })
+        end
+
+        assert_equal total_count, all_ids.length,
+          "walking every page should yield exactly total_count records"
+        assert_equal all_ids.uniq.length, all_ids.length,
+          "no id should be duplicated across pages"
+
+        created_ids.each do |id|
+          assert_equal 1, all_ids.count(id),
+            "id #{id} should appear exactly once across all pages, appeared #{all_ids.count(id)} times"
+        end
+      end
+
+      test "index orders by name then id" do
+        seen = []
+        probe = ->(*, payload) { seen << payload[:sql] if payload[:sql].include?('FROM "projects"') }
+        ActiveSupport::Notifications.subscribed(probe, "sql.active_record") { get api_v1_projects_url }
+
+        assert seen.any? { |s| s.include?(%q(ORDER BY "projects"."name" ASC, "projects"."id" ASC)) },
+          "index must order by name then id - without the id tiebreaker, LIMIT/OFFSET " \
+          "paging can duplicate and skip records with duplicate names"
+      end
+
+      test "index records expose exactly id, name, archived keys" do
+        Project.create!(name: "KeySetTest", archived: false)
+
+        get api_v1_projects_url(per_page: 100)
+        assert_response :success
+
+        record = JSON.parse(response.body)["data"].find { |p| p["name"] == "KeySetTest" }
+        assert record, "expected the created project to be present in the response"
+        assert_equal %w[archived id name], record.keys.sort
+      end
+
+      # --- show ------------------------------------------------------------
+
+      test "show returns 200 with the project nested under data" do
+        project = Project.create!(name: "ShowTest", description: "A project", archived: false)
+
+        get api_v1_project_url(project)
+        assert_response :success
+
+        json = JSON.parse(response.body)
+        assert json.key?("data"), "expected response body to have a \"data\" key"
+        assert_equal project.id, json["data"]["id"]
+        assert_equal "ShowTest", json["data"]["name"]
+      end
+
+      test "show record exposes exactly id, name, description, archived keys" do
+        project = Project.create!(name: "ShowKeysTest", description: "A project", archived: false)
+
+        get api_v1_project_url(project)
+        assert_response :success
+
+        data = JSON.parse(response.body)["data"]
+        assert_equal %w[archived description id name], data.keys.sort
+      end
+
+      test "show returns 200 for an archived project" do
+        project = Project.create!(name: "ArchivedShowTest", archived: true)
+
+        get api_v1_project_url(project)
+        assert_response :success
+
+        data = JSON.parse(response.body)["data"]
+        assert_equal true, data["archived"]
+      end
+
+      test "show with an unknown id returns 404 with a JSON error envelope" do
+        project = Project.create!(name: "SoonToBeDeleted", archived: false)
+        missing_id = project.id
+        project.destroy!
+
+        get api_v1_project_url(id: missing_id)
+        assert_response :not_found
+        assert_equal "application/json", response.media_type,
+          "expected a JSON error response, never HTML"
+
+        json = JSON.parse(response.body)
+        assert json.key?("error"), "expected an \"error\" key in the response body"
+        assert_equal "not_found", json["error"]["code"]
+        assert json["error"]["message"].present?
+      end
+
+      test "show with a bignum id returns 404 without raising" do
+        get "/api/v1/projects/#{"9" * 30}"
+        assert_response :not_found
+        assert_equal "application/json", response.media_type,
+          "expected a JSON error response, never HTML or a 500"
+
+        json = JSON.parse(response.body)
+        assert_equal "not_found", json["error"]["code"]
+      end
+    end
+  end
+end
