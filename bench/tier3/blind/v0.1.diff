diff --git a/app/controllers/api/v1/base_controller.rb b/app/controllers/api/v1/base_controller.rb
new file mode 100644
index 0000000..65c523c
--- /dev/null
+++ b/app/controllers/api/v1/base_controller.rb
@@ -0,0 +1,66 @@
+module Api
+  module V1
+    # Base class for the /api/v1 namespace. Inherits ActionController::API
+    # directly (NOT ApplicationController) so this namespace stays decoupled
+    # from HTML-era, browser-facing concerns (allow_browser gating,
+    # importmap staleness, cookies, CSRF, view rendering).
+    class BaseController < ActionController::API
+      DEFAULT_PAGE = 1
+      DEFAULT_PER_PAGE = 25
+      MAX_PER_PAGE = 100
+
+      rescue_from ActiveRecord::RecordNotFound, with: :render_not_found
+
+      private
+
+      # Paginates an ActiveRecord::Relation with defensive, never-raising
+      # coercion of caller-supplied page/per_page params, and short-circuits
+      # to an empty result (rather than issuing a huge-OFFSET query) when the
+      # requested page is beyond the last page.
+      #
+      # Returns [records, pagination_hash].
+      def paginate(scope)
+        page = safe_page
+        per_page = safe_per_page
+
+        total_count = scope.count
+        total_pages = total_count.zero? ? 0 : (total_count.to_f / per_page).ceil
+
+        records = if total_count.zero? || page > total_pages
+          scope.none
+        else
+          scope.limit(per_page).offset((page - 1) * per_page)
+        end
+
+        pagination = {
+          page: page,
+          per_page: per_page,
+          total_count: total_count,
+          total_pages: total_pages
+        }
+
+        [ records, pagination ]
+      end
+
+      # params[:page] is not guaranteed to be a String (e.g. page[]=1 makes it
+      # an Array, page[x]=1 makes it Parameters/Hash). Coerce defensively via
+      # #to_s so any shape degrades to the default instead of raising.
+      def safe_page
+        page = params[:page].to_s.to_i
+        page < 1 ? DEFAULT_PAGE : page
+      end
+
+      def safe_per_page
+        per_page = params[:per_page].to_s.to_i
+        return DEFAULT_PER_PAGE if per_page < 1
+        [ per_page, MAX_PER_PAGE ].min
+      end
+
+      def render_not_found(exception)
+        resource = exception.model || "Record"
+        render json: { error: { code: "not_found", message: "#{resource} not found" } },
+               status: :not_found
+      end
+    end
+  end
+end
diff --git a/app/controllers/api/v1/projects_controller.rb b/app/controllers/api/v1/projects_controller.rb
new file mode 100644
index 0000000..788b80c
--- /dev/null
+++ b/app/controllers/api/v1/projects_controller.rb
@@ -0,0 +1,20 @@
+module Api
+  module V1
+    class ProjectsController < BaseController
+      def index
+        records, pagination = paginate(Project.active.order(:name, :id))
+
+        render json: {
+          data: records.as_json(only: %i[id name archived]),
+          pagination: pagination
+        }
+      end
+
+      def show
+        project = Project.find(params[:id])
+
+        render json: { data: project.as_json(only: %i[id name description archived]) }
+      end
+    end
+  end
+end
