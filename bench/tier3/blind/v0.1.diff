@@ -0,0 +1,11 @@
+class AddIndexToProjectsArchivedAndName < ActiveRecord::Migration[8.1]
+  def change
+    # Covering index for the API list query:
+    #   WHERE archived = ? ORDER BY name, id LIMIT ? OFFSET ?
+    # plus the COUNT(*) for total_count. Column order matters: the equality
+    # predicate (archived) comes first, followed by the sort columns in sort
+    # order (name, id), so the query is served without a full table scan or
+    # filesort.
+    add_index :projects, [:archived, :name, :id], name: "index_projects_on_archived_and_name_and_id"
+  end
+end
