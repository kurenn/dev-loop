@@ -0,0 +1,15 @@
+class Api::V1::ProjectsController < Api::V1::BaseController
+  def index
+    result = Pagination.paginate(Project.active.order(:name, :id), page: params[:page], per_page: params[:per_page])
+
+    render json: {
+      projects: result[:records].as_json(only: [ :id, :name, :archived ]),
+      pagination: result[:pagination]
+    }
+  end
+
+  def show
+    project = Project.find(params[:id])
+    render json: project.as_json(only: [ :id, :name, :description, :archived ])
+  end
+end
diff --git a/app/controllers/concerns/pagination.rb b/app/controllers/concerns/pagination.rb
new file mode 100644
index 0000000..9d93a87
--- /dev/null
+++ b/app/controllers/concerns/pagination.rb
@@ -0,0 +1,82 @@
+# Hand-rolled limit/offset pagination for API list endpoints.
+#
+# Usable both as a module function:
+#
+#   Pagination.paginate(Project.active, page: params[:page], per_page: params[:per_page])
+#
+# and as a mixin:
+#
+#   class ProjectsController < ApplicationController
+#     include Pagination
+#
+#     def index
+#       result = paginate(Project.active, page: params[:page], per_page: params[:per_page])
+#     end
+#   end
+#
+# Accepts raw param values (strings, nil, anything) — never raises and never
+# signals a 4xx for malformed pagination params. Invalid/absent values fall
+# back to defaults; out-of-range per_page is silently clamped to the max.
+#
+# Parsing note: page/per_page accept only strict decimal digit strings
+# (`\A\d+\z`, e.g. "10", "010" -> 10). Anything else — non-numeric strings,
+# whitespace padding, signs, underscores, non-decimal prefixes like "0x10",
+# array/hash-shaped params, nil — falls back to the default. This is
+# intentional and stricter than Ruby's `Integer()` conversion rules, which
+# would otherwise interpret zero-padded values like "010" as octal.
+module Pagination
+  extend self
+
+  DEFAULT_PER_PAGE = 25
+  MAX_PER_PAGE = 100
+
+  # @param scope [ActiveRecord::Relation]
+  # @param page [Object] raw, unvalidated param value
+  # @param per_page [Object] raw, unvalidated param value
+  # @return [Hash] { records:, pagination: { page:, per_page:, total_count:, total_pages: } }
+  def paginate(scope, page:, per_page:)
+    parsed_page = parse_positive_integer(page, default: 1)
+    parsed_per_page = clamp_per_page(parse_positive_integer(per_page, default: DEFAULT_PER_PAGE))
+
+    total_count = scope.count
+    total_pages = (total_count / parsed_per_page.to_f).ceil
+    offset = (parsed_page - 1) * parsed_per_page
+
+    # Short-circuit rather than issuing LIMIT/OFFSET once the offset is past
+    # the end of the result set. This avoids handing the DB driver an offset
+    # so large it can't bind (e.g. SQLite/Postgres bigint ceilings around
+    # 2**63), and it also skips a pointless query for any other past-the-end
+    # page. `parsed_page` itself is never clamped — callers get back exactly
+    # the page they asked for, with truthful (empty) results.
+    records = offset >= total_count ? scope.none : scope.limit(parsed_per_page).offset(offset)
+
+    {
+      records: records,
+      pagination: {
+        page: parsed_page,
+        per_page: parsed_per_page,
+        total_count: total_count,
+        total_pages: total_pages
+      }
+    }
+  end
+
+  private
+
+  # Parses a raw value into a positive Integer, falling back to `default`
+  # for nil, non-numeric strings, non-decimal numeric strings (e.g. "0x10",
+  # "1_00", "10.5"), whitespace-padded or signed strings (e.g. " 5 ", "+3"),
+  # array/hash-shaped params, zero, and negative values. Only strings
+  # consisting entirely of decimal digits are accepted, so "010" parses as
+  # 10 (never octal). Never raises.
+  def parse_positive_integer(raw, default:)
+    return default unless raw.to_s.match?(/\A\d+\z/)
+
+    value = raw.to_s.to_i
+    value <= 0 ? default : value
+  end
+
+  def clamp_per_page(value)
+    [value, MAX_PER_PAGE].min
+  end
+end
diff --git a/app/models/project.rb b/app/models/project.rb
index 6c0e59f..daaaf34 100644
--- a/app/models/project.rb
+++ b/app/models/project.rb
@@ -3,5 +3,11 @@ class Project < ApplicationRecord
 
   validates :name, presence: true
 
+  # `archived` is a nullable boolean with no DB default, and `where(archived: false)`
+  # does not match `archived IS NULL`. So `Project.create!(name: "X")` yields a row
+  # invisible to this scope (and to every list endpoint built on it) while still
+  # fetchable by id. `/api/v1` mirrors this deliberately for parity with `/projects`
+  # (see PLAN.md Assumption 7) — don't "fix" the scope alone; the real fix is a
+  # backfill plus a `NOT NULL DEFAULT false` migration, deliberately out of scope here.
   scope :active, -> { where(archived: false) }
 end
