diff --git a/app/controllers/api/v1/base_controller.rb b/app/controllers/api/v1/base_controller.rb
new file mode 100644
index 0000000..26b8865
--- /dev/null
+++ b/app/controllers/api/v1/base_controller.rb
@@ -0,0 +1,35 @@
+class Api::V1::BaseController < ActionController::API
+  # rescue_from matches last-registered-first, so the catch-all StandardError
+  # handler must be registered before the more specific RecordNotFound
+  # handler for the specific one to win.
+  rescue_from StandardError, with: :render_internal_error
+  rescue_from ActiveRecord::RecordNotFound, with: :render_not_found
+
+  private
+
+  def render_not_found
+    render json: { error: "not_found" }, status: :not_found
+  end
+
+  # Fallback for anything raised inside API actions so it doesn't escape to
+  # ActionDispatch::PublicExceptions (which would respond with HTML for
+  # clients that send no Accept header). When the app is configured to show
+  # full error detail locally (development, and this app's test env), we
+  # re-raise instead so Rails' own DebugExceptions middleware -- and, in
+  # tests, a visible failure with a real backtrace -- takes over; the JSON
+  # contract below only matters where nobody is watching the console, i.e.
+  # production.
+  #
+  # The Rails.error.report call is a hook for a future error-tracking
+  # subscriber (e.g. an APM gem) to pick up; this app has none configured
+  # today, so it currently writes nothing anywhere. The record that survives
+  # in every environment is Rails 8.1's own ActionController::LogSubscriber
+  # #rescue_from_callback line, logged regardless of whether report is
+  # called.
+  def render_internal_error(exception)
+    raise exception if Rails.application.config.consider_all_requests_local
+
+    Rails.error.report(exception, handled: false, severity: :error, source: "api")
+    render json: { error: "internal_error" }, status: :internal_server_error
+  end
+end
diff --git a/app/controllers/api/v1/projects_controller.rb b/app/controllers/api/v1/projects_controller.rb
