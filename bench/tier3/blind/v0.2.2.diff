+require "test_helper"
+
+# Characterization test for the legacy /projects and /projects/:id endpoints.
+#
+# A new /api/v1/projects namespace is being introduced alongside these
+# endpoints, sharing config/routes.rb. This test pins the *current*,
+# unimproved behavior of ProjectsController byte-for-byte-ish so that any
+# accidental regression in routing, serialization, ordering, or scoping
+# fails loudly. Do not "fix" anything this test finds — if it fails, the
+# legacy behavior changed and that's the bug.
+class LegacyProjectsRegressionTest < ActionDispatch::IntegrationTest
+  test "GET /projects returns a bare JSON array with exactly id/name/archived keys" do
+    get projects_url
+    assert_response :success
+
+    body = JSON.parse(response.body)
+    assert_kind_of Array, body, "legacy index must render a bare array, not an envelope"
+    assert_not_empty body
+
+    body.each do |project_json|
+      assert_equal %w[archived id name], project_json.keys.sort,
+        "legacy index must only expose id/name/archived, no description or timestamps"
+    end
+  end
+
+  test "GET /projects is active-only: excludes archived fixture, includes active fixture" do
+    get projects_url
+    assert_response :success
+
+    names = JSON.parse(response.body).map { |p| p["name"] }
+    assert_includes names, "Alpha"
+    assert_not_includes names, "Zulu"
+  end
+
+  test "GET /projects orders results by name ascending" do
+    low = Project.create!(name: "AAARegressionOrderLow", archived: false)
+    mid = Project.create!(name: "MMMRegressionOrderMid", archived: false)
+    high = Project.create!(name: "ZZZRegressionOrderHigh", archived: false)
+
+    get projects_url
+    assert_response :success
+
+    ordered_names = JSON.parse(response.body)
+      .map { |p| p["name"] }
+      .select { |name| name.include?("RegressionOrder") }
+
+    assert_equal [ low.name, mid.name, high.name ], ordered_names
+  end
+
+  test "GET /projects/:id returns a bare JSON object with exactly id/name/description/archived keys" do
+    get project_url(projects(:alpha))
+    assert_response :success
+
+    body = JSON.parse(response.body)
+    assert_kind_of Hash, body, "legacy show must render a bare object, not an array or envelope"
+    assert_equal %w[archived description id name], body.keys.sort
+  end
+
+  test "GET /projects/:id has no active filter and returns archived projects too" do
+    get project_url(projects(:zulu))
+    assert_response :success
+
+    body = JSON.parse(response.body)
+    assert_equal "Zulu", body["name"]
+    assert_equal true, body["archived"]
+  end
+
+  test "NULL-archived parity: legacy index excludes NULL archived, legacy show still returns it" do
+    null_flag_project = Project.create!(name: "RegressionNullFlagProject", archived: nil)
+
+    get projects_url
+    assert_response :success
+    index_names = JSON.parse(response.body).map { |p| p["name"] }
+    assert_not_includes index_names, null_flag_project.name,
+      "Project.active uses where(archived: false), which does not match NULL rows in SQL"
+
+    get project_url(null_flag_project)
+    assert_response :success
+    body = JSON.parse(response.body)
+    assert_equal null_flag_project.name, body["name"]
+    assert_nil body["archived"]
+  end
+
+  test "root route maps to projects#index and returns the same bare array" do
+    get root_url
+    assert_response :success
+
+    body = JSON.parse(response.body)
+    assert_kind_of Array, body
+
+    names = body.map { |p| p["name"] }
+    assert_includes names, "Alpha"
+    assert_not_includes names, "Zulu"
+  end
+end
