+module Api
+  module V1
+    class BaseController < ActionController::API
+      before_action :require_api_token
+
+      private
+
+      def require_api_token
+        token = request.headers["X-Api-Token"]
+        head :unauthorized unless ApiToken.active.exists?(value: token)
+      end
+    end
+  end
+end
