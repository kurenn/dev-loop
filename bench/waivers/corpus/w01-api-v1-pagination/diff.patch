diff --git a/app/controllers/api/v1/projects_controller.rb b/app/controllers/api/v1/projects_controller.rb
new file mode 100644
index 0000000..ce758ea
--- /dev/null
+++ b/app/controllers/api/v1/projects_controller.rb
@@ -0,0 +1,35 @@
+module Api
+  module V1
+    class ProjectsController < ActionController::API
+      DEFAULT_PER_PAGE = 25
+      MAX_PER_PAGE = 100
+
+      rescue_from ActiveRecord::RecordNotFound do
+        render json: { error: "Not Found" }, status: :not_found
+      end
+
+      def index
+        page = Integer(params[:page], exception: false)
+        page = page&.positive? ? page : 1
+
+        per_page = Integer(params[:per_page], exception: false)
+        per_page = per_page&.positive? ? [ per_page, MAX_PER_PAGE ].min : DEFAULT_PER_PAGE
+
+        total = Project.active.count
+        offset = (page - 1) * per_page
+        # ponytail: offset pagination; switch to keyset if projects reach ~1M rows
+        projects = offset < total ? Project.active.order(:name, :id).offset(offset).limit(per_page) : []
+
+        render json: {
+          data: projects.as_json(only: [ :id, :name, :archived ]),
+          pagination: { page: page, per_page: per_page, total_count: total, total_pages: (total.to_f / per_page).ceil }
+        }
+      end
+
+      def show
+        project = Project.find(params[:id])
+        render json: project.as_json(only: [ :id, :name, :description, :archived ])
+      end
+    end
+  end
+end
